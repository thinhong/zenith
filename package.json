{
  "name": "zenith",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Zenith: a small collection of quiet web apps for looking at life from outside it. No goals, no score.",
  "workspaces": [
    "home",
    "apps/*"
  ],
  "scripts": {
    "dev:home": "npm run dev -w @zenith/home",
    "dev:above": "npm run dev -w @zenith/above",
    "dev:lives": "npm run dev -w @zenith/lives",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "smoke": "npm run smoke --workspaces --if-present"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
